# 复制为 .env 后按环境填写；勿提交真实密钥
APP_ENV=dev
APP_DEBUG=true

# MySQL（UTC）
DATABASE_URL=mysql+pymysql://wms:wms@127.0.0.1:3306/wms?charset=utf8mb4

# JWT Access Token（MVP 无 Refresh）
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=480

# CORS：开发环境 Vite 源；小程序不依赖浏览器 CORS
CORS_ORIGINS=http://localhost:5173
